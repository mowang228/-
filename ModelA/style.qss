/* ============================================================
   套牌车稽查系统 — 全局样式表
   ============================================================ */

/* ---- 全局 ---- */
QMainWindow {
    background-color: #eef1f5;
}

#scrollArea {
    background-color: transparent;
    border: none;
}

/* ---- 中央容器 ---- */
#container {
    background-color: transparent;
}

/* ---- 顶部标题 ---- */
#header {
    font-size: 26px;
    font-weight: bold;
    color: #1a2332;
    padding: 8px 0 2px 0;
    letter-spacing: 2px;
}

/* ---- 步骤导航 ---- */
#stepNav {
    background-color: #ffffff;
    border: 1px solid #e4e8ed;
    border-radius: 10px;
    padding: 14px 24px;
}

/* 步骤编号 — 圆形徽章 */
#stepNum_1, #stepNum_2, #stepNum_3 {
    font-size: 15px;
    font-weight: bold;
    color: #ffffff;
    background-color: #2c3e50;
    border-radius: 12px;
    padding: 2px 10px;
    min-width: 24px;
    min-height: 24px;
}

/* 步骤文字 */
#stepText_1, #stepText_2, #stepText_3 {
    font-size: 14px;
    font-weight: 600;
    color: #4a5568;
    letter-spacing: 1px;
}

/* ---- 三栏卡片统一风格 ---- */
#servicePrepare,
#uploadPredict,
#resultShow {
    background-color: #ffffff;
    border: 1px solid #e4e8ed;
    border-radius: 12px;
}

#servicePrepare {
    padding: 0;
}

#uploadPredict {
    padding: 16px 20px;
}

#resultShow {
    padding: 16px;
}

/* ---- 左侧：雷达图节点 ---- */
#carDiagram {
    background-color: transparent;
}

#carCenter {
    background-color: #d5dde8;
    border: 3px solid #ffffff;
    border-radius: 16px;
}

/* 8 个节点按语义分组配色 */
#node_1, #node_5 {
    /* 车牌 / 年检 — 蓝色系 */
    background-color: #3b82f6;
}

#node_2, #node_6 {
    /* 车型 / 违章 — 靛青色 */
    background-color: #6366f1;
}

#node_3, #node_7 {
    /* 颜色 / 保险 — 紫色系 */
    background-color: #8b5cf6;
}

#node_4, #node_8 {
    /* 车主 / 轨迹 — 青色系 */
    background-color: #14b8a6;
}

#node_1, #node_2, #node_3, #node_4,
#node_5, #node_6, #node_7, #node_8 {
    font-size: 12px;
    font-weight: 600;
    color: #ffffff;
    border-radius: 8px;
    padding: 4px 12px;
}

/* ---- 中间：上传 & 预测 ---- */
#uploadTitle {
    font-size: 17px;
    font-weight: bold;
    color: #1e293b;
    padding-bottom: 6px;
}

/* 选择文件按钮 */
#fileBtn {
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    background-color: #3b82f6;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    min-width: 140px;
}

#fileBtn:hover {
    background-color: #2563eb;
}

#fileBtn:pressed {
    background-color: #1d4ed8;
}

/* 文件路径输入框 */
#fileName {
    font-size: 13px;
    color: #475569;
    background-color: #f8fafc;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 12px;
}

/* 开始分析按钮 */
#analyzeBtn {
    font-size: 15px;
    font-weight: bold;
    color: #ffffff;
    background-color: #ef4444;
    border: none;
    border-radius: 8px;
    padding: 12px 20px;
    min-width: 140px;
}

#analyzeBtn:hover {
    background-color: #dc2626;
}

#analyzeBtn:pressed {
    background-color: #b91c1c;
}

/* 使用百度API复选框 */
#baiduApiCheck {
    /* 样式已在 mainwindow.cpp 中通过 setIcon + setStyleSheet 实现 */
}

/* 提示信息 */
#tip {
    font-size: 13px;
    color: #16a34a;
    padding-top: 8px;
}

#formatInfo {
    font-size: 12px;
    color: #9ca3af;
    padding-top: 4px;
}

/* ---- 右侧：结果展示 ---- */
#resultImg {
    border: 2px solid #cbd5e1;
    border-radius: 10px;
    background-color: #f1f5f9;
}

#formLabel {
    font-size: 13px;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 0.5px;
}

/* 普通表单输入 */
#formInput {
    font-size: 14px;
    color: #1e293b;
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 6px 12px;
    min-height: 20px;
}

#formInput:focus {
    border: 1px solid #e2e8f0;
    background-color: #f8fafc;
    outline: none;
}

/* 稽查结论（特殊高亮） */
#conclusionInput {
    font-size: 15px;
    font-weight: bold;
    color: #dc2626;
    background-color: #fef2f2;
    border: 1.5px solid #fca5a5;
    border-radius: 8px;
    padding: 8px 12px;
}

#conclusionInput:focus {
    border: 1.5px solid #fca5a5;
    background-color: #fef2f2;
    outline: none;
}

/* ---- 新 UI 样式 ---- */

/* 卡片标题 */
#cardTitle {
    font-size: 17px;
    font-weight: bold;
    color: #1e293b;
    padding: 4px 0 8px 0;
}

/* 车辆图标 */
#vehicleIcon {
    font-size: 54px;
    background-color: #f1f5f9;
    border-radius: 14px;
    padding: 12px;
    min-height: 80px;
}

/* 功能列表项 */
#featureItem {
    font-size: 15px;
    color: #334155;
    padding: 10px 16px;
    background-color: #f8fafc;
    border-radius: 8px;
    margin: 2px 0;
}

/* 状态徽章 — 默认 */
#statusBadge {
    background-color: #f1f5f9;
    color: #64748b;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding: 8px 16px;
    min-height: 24px;
}

#statusBadge[riskLevel="low"] {
    background-color: #dcfce7;
    color: #166534;
    border: 1px solid #86efac;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding: 8px 16px;
    min-height: 24px;
}

#statusBadge[riskLevel="middle"] {
    background-color: #fef3c7;
    color: #92400e;
    border: 1px solid #fcd34d;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding: 8px 16px;
    min-height: 24px;
}

#statusBadge[riskLevel="high"],
#statusBadge[riskLevel="unknown"] {
    background-color: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding: 8px 16px;
    min-height: 24px;
}

/* 差异说明标题 */
#diffTitle {
    font-size: 13px;
    font-weight: 600;
    color: #64748b;
    padding-top: 2px;
}

/* 差异列表 */
#diffList {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 12px;
    padding: 4px;
}

#diffList::item {
    padding: 3px 8px;
    color: #475569;
}

/* 对比表格区域 */
#compareSection {
    background-color: #ffffff;
    border: 1px solid #e4e8ed;
    border-radius: 12px;
    margin-top: 8px;
}

#tableTitle {
    font-size: 16px;
    font-weight: bold;
    color: #1e293b;
}

/* 对比表格 */
#compareTable {
    border: none;
    background-color: transparent;
    alternate-background-color: #f8f9fb;
    font-size: 13px;
}

#compareTable::item {
    padding: 6px 12px;
    border: none;
}

#compareTable::item:selected {
    background-color: transparent;
    color: inherit;
}

/* ============================================================
   登录 / 注册对话框
   ============================================================ */
#loginDialog {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 16px;
}

#loginTitle {
    font-size: 22px;
    font-weight: bold;
    color: #1a2332;
    letter-spacing: 2px;
    padding: 10px 0;
}

#loginInput {
    font-size: 14px;
    color: #1e293b;
    background-color: #f8fafc;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 10px 14px;
    min-height: 20px;
}

#loginInput:focus {
    border: 1px solid #3b82f6;
    background-color: #ffffff;
}

#loginBtn {
    font-size: 15px;
    font-weight: bold;
    color: #ffffff;
    background-color: #3b82f6;
    border: none;
    border-radius: 8px;
    padding: 12px 20px;
    min-height: 20px;
}

#loginBtn:hover {
    background-color: #2563eb;
}

#loginBtn:pressed {
    background-color: #1d4ed8;
}

#loginBtn:disabled {
    background-color: #94a3b8;
}

#loginMsg {
    font-size: 13px;
    color: #ef4444;
    min-height: 20px;
}

#switchBtn {
    font-size: 13px;
    color: #3b82f6;
    background: transparent;
    border: none;
    text-decoration: underline;
    padding: 4px;
}

#switchBtn:hover {
    color: #1d4ed8;
}

#loginFooter {
    font-size: 12px;
    color: #94a3b8;
    padding-top: 4px;
}
